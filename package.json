{
  "name": "dumb-links",
  "displayName": "Dumb Links",
  "publisher": "gregoire",
  "repository": {
    "type": "git",
    "url": "https://github.com/71/vscode-dumb-links"
  },
  "version": "0.1.0",
  "license": "MPL-2.0",
  "categories": [
    "Linters",
    "Other"
  ],

  "engines": {
    "vscode": "^1.110.0"
  },
  "packageManager": "pnpm@10.33.2",

  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "This extension can be enabled and configured in untrusted workspaces."
    }
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",

  "contributes": {
    "configuration": {
      "title": "Dumb Links",
      "properties": {
        "dumbLinks.enable": {
          "markdownDescription": "If false, all rules are ignored. This takes precendence over `#dumbLinks.overrides#`.",
          "type": "boolean",
          "default": true,
          "order": 0,
          "scope": "language-overridable"
        },
        "dumbLinks.overrides": {
          "additionalProperties": {
            "^[@~]?\\w+$": {
              "markdownDescription": "Override the behavior of built-in rules.",
              "properties": {
                "enable": {
                  "description": "If false, ignore this rule.",
                  "type": "boolean",
                  "default": true
                },
                "ifCannotReadFile": {
                  "description": "Behavior if the target file cannot be opened.",
                  "enum": ["ignore", "warn", "error"],
                  "enumDescriptions": [
                    "Ignore silently.",
                    "Display a warning.",
                    "Display an error."
                  ],
                  "default": "error"
                },
                "ifCannotFindTarget": {
                  "markdownDescription": "Behavior if the target symbol or text snippet cannot be found.",
                  "enum": [
                    "ignore",
                    "warn",
                    "error",
                    "link",
                    "warn-link",
                    "error-link"
                  ],
                  "enumDescriptions": [
                    "Ignore silently without linking.",
                    "Display a warning without linking.",
                    "Display an error without linking.",
                    "Link to the file.",
                    "Display a warning and link to the file.",
                    "Display an error and link to the file."
                  ],
                  "default": "warn-link"
                }
              }
            }
          },
          "propertyNames": {
            "enum": ["absolute", "relative", "implicit"],
            "markdownEnumDescriptions": [
              "Absolute links starting with `//`.",
              "Relative links starting with `./` or `../`.",
              "Implicit links made up of several words separated by `/`."
            ]
          },
          "default": {
            "implicit": {
              "ifCannotReadFile": "ignore"
            }
          },
          "order": 1,
          "scope": "language-overridable"
        }
      }
    }
  },

  "scripts": {
    "check-types": "tsc --noEmit",
    "check": "npm-run-all -p check-types lint",
    "compile-tests": "tsc -p . --outDir out",
    "compile": "pnpm run check && node esbuild.mjs",
    "lint": "eslint src",
    "package-vsix": "vsce package",
    "prepackage": "pnpm run check && node esbuild.mjs --production",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "test": "vscode-test",
    "vscode:prepublish": "pnpm run prepackage",
    "watch-tests": "tsc -p . -w --outDir out",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch": "npm-run-all -p watch:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@vscode/vsce": "^3.9.1",
    "typescript-eslint": "^8.59.1",
    "eslint": "^10.3.0",
    "esbuild": "^0.28.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
